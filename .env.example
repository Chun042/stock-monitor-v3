# Copy to .env for local data testing. Never commit .env.
# FINMIND_TOKEN=your_finmind_token

# Keep LINE and Web Push credentials empty for safe local testing.
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_USER_ID=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_SUB=mailto:you@example.com
# WEB_PUSH_SUBSCRIPTIONS=

# Multi-user Cloudflare Worker
# PUSH_API_BASE=https://your-worker.workers.dev
# PUSH_ADMIN_TOKEN=your-admin-token
